# HealthSync Uganda — Crane Cloud PILOT environment
#
# Copy to pilot.env (gitignored) and fill in real values.
#
#   cp pilot.env.example pilot.env
#   $EDITOR pilot.env
#
# Then deploy:
#   make -C infra/cranecloud deploy ENV=pilot

# ── Crane Cloud project ──────────────────────────────────────────────────
CRANECLOUD_PROJECT_ID=

# ── Managed Postgres (Crane Cloud DaaS) ─────────────────────────────────
# Postgres is the Crane Cloud *managed* database (durable storage), not a
# self-hosted app. Provision it once via the web UI:
#   Project → Databases → + New Database → PostgreSQL → Create
# then copy its connection string into DATABASE_URL below. The app creates the
# required pgcrypto / pg_trgm / btree_gin extensions itself on first startup.

# ── Redis app (deployed as a Crane Cloud app — no managed Redis DaaS) ───
REDIS_APP_NAME=healthsync-redis-pilot
REDIS_IMAGE=redis
REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379
REDIS_REPLICAS=1
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=
REDIS_APP_ID=
REDIS_HOSTNAME=healthsync-redis-pilot

# ── Backend app ──────────────────────────────────────────────────────────
BACKEND_APP_NAME=healthsync-backend-pilot
BACKEND_IMAGE=docker.io/mpairwe7/healthsync-uganda-backend
BACKEND_IMAGE_TAG=pilot
BACKEND_PORT=8000
BACKEND_REPLICAS=2
BACKEND_APP_ID=

# ── Frontend app ─────────────────────────────────────────────────────────
FRONTEND_APP_NAME=healthsync-frontend-pilot
FRONTEND_IMAGE=docker.io/mpairwe7/healthsync-uganda-frontend
FRONTEND_IMAGE_TAG=pilot
FRONTEND_PORT=3000
FRONTEND_REPLICAS=2
FRONTEND_APP_ID=

# ── Application config ───────────────────────────────────────────────────
APP_ENV=production
APP_NAME=healthsync-uganda
LOG_LEVEL=INFO

# CRITICAL: pilot SECRET_KEY must be unique per environment and rotated
# annually or on incident. Prefer Crane Cloud secret manager over CLI -e.
SECRET_KEY=

# ── Database URL — the managed Postgres (DaaS) connection string ────────
# Paste the connection string from the Crane Cloud Databases UI, rewriting the
# scheme to `postgresql+asyncpg://` (required by the SQLAlchemy async engine):
#   postgresql+asyncpg://<user>:<password>@<daas-host>:5432/<db>
# DaaS storage is managed/durable, so the self-hosted pg_dump-before-PHI
# caveat no longer applies to Postgres.
DATABASE_URL=

# ── Cache & queue — Redis (the app deployed via make deploy-redis) ──────
# redis://:${REDIS_PASSWORD}@${REDIS_HOSTNAME}:6379/0
REDIS_URL=

# ── Observability ────────────────────────────────────────────────────────
# NITA-U Grafana / Tempo / Loki endpoint (pilot tier).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=healthsync-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1   # 10% sampling — uncomment in production

# ── External integrations (real endpoints in pilot) ──────────────────────
# NIRA OIDC or REST — replace with real production URLs when issued.
NIRA_BASE_URL=
NIRA_API_KEY=
DHIS2_BASE_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=

# ── Resilience tuning ────────────────────────────────────────────────────
# Tighter than staging — fewer retries, faster breaker trip.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=45
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=250

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=https://healthsync-frontend-pilot.cranecloud.ug

# ── Frontend public config ───────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://healthsync-backend-pilot.cranecloud.ug
NEXT_PUBLIC_APP_NAME=HealthSync Uganda
