# HealthSync Uganda — Crane Cloud PRODUCTION environment
#
# Copy to production.env (gitignored) and fill in real values.
#
#   cp production.env.example production.env
#   $EDITOR production.env
#
# Deploys to production REQUIRE two-person review and DPO sign-off
# per ADR 0000 governance. Do NOT deploy from a personal workstation
# without that sign-off recorded.
#
# Then deploy:
#   make -C infra/cranecloud deploy ENV=production

# ── Crane Cloud project ──────────────────────────────────────────────────
CRANECLOUD_PROJECT_ID=

# ── Postgres app — production ───────────────────────────────────────────
# WITHOUT confirmed persistent volumes, running Postgres self-hosted on
# Crane Cloud is a SEV-1 data-durability risk. Before production go-live,
# either (a) confirm Crane Cloud persistent volumes are available, or
# (b) switch to Crane Cloud DaaS (Project → Databases → + New Database),
# or (c) migrate to NITA-U Government Cloud. The values below are
# placeholders for the self-hosted shape; do not deploy production with
# real PHI until durability is resolved.
POSTGRES_APP_NAME=healthsync-postgres
POSTGRES_IMAGE=ghcr.io/mpairwe7/healthsync-uganda-postgres
POSTGRES_IMAGE_TAG=          # pin to v* tag for production
POSTGRES_PORT=5432
POSTGRES_REPLICAS=1
POSTGRES_USER=healthsync
POSTGRES_PASSWORD=
POSTGRES_DB=healthsync
POSTGRES_APP_ID=
POSTGRES_HOSTNAME=healthsync-postgres

# ── Redis app — production ──────────────────────────────────────────────
# Without managed Redis on Crane Cloud, this is a single-replica app. For
# stronger durability of the DHIS2 outbox at national scale, consider a
# Postgres-backed outbox replica (separate ADR; see THREAT_MODEL §6 RR-04).
REDIS_APP_NAME=healthsync-redis
REDIS_IMAGE=redis
REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379
REDIS_REPLICAS=1
REDIS_PASSWORD=           # 32+ char random; rotate per SECURITY.md cadence
REDIS_APP_ID=
REDIS_HOSTNAME=healthsync-redis

# ── Backend app ──────────────────────────────────────────────────────────
BACKEND_APP_NAME=healthsync-backend
BACKEND_IMAGE=ghcr.io/mpairwe7/healthsync-uganda-backend
# Production images are tagged with the release version, not "latest".
BACKEND_IMAGE_TAG=
BACKEND_PORT=8000
BACKEND_REPLICAS=4
BACKEND_APP_ID=

# ── Frontend app ─────────────────────────────────────────────────────────
FRONTEND_APP_NAME=healthsync-frontend
FRONTEND_IMAGE=ghcr.io/mpairwe7/healthsync-uganda-frontend
FRONTEND_IMAGE_TAG=
FRONTEND_PORT=3000
FRONTEND_REPLICAS=4
FRONTEND_APP_ID=

# ── Application config ───────────────────────────────────────────────────
APP_ENV=production
APP_NAME=healthsync-uganda
LOG_LEVEL=INFO

# SECRET_KEY rotation: see docs/SECURITY.md §"Penetration testing & vulnerability
# management". Pre-rotation, set in Crane Cloud secret manager — NOT here.
SECRET_KEY=

# ── Database URL — points at the self-hosted Postgres app above ─────────
# postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOSTNAME}:5432/${POSTGRES_DB}
# CRITICAL: self-hosted Postgres on Crane Cloud without confirmed
# persistent volumes is unsuitable for production PHI. See the warning
# above and the resolution paths there.
DATABASE_URL=

# ── Cache & queue — Redis (the app deployed via make deploy-redis) ──────
# redis://:${REDIS_PASSWORD}@${REDIS_HOSTNAME}:6379/0
REDIS_URL=

# ── Observability ────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=healthsync-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.05  # 5% sampling at national scale

# ── External integrations (real NIRA + DHIS2) ────────────────────────────
NIRA_BASE_URL=
NIRA_API_KEY=
DHIS2_BASE_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=

# ── Resilience tuning ────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=60
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=300

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=https://healthsync.go.ug,https://healthsync-frontend.cranecloud.ug

# ── Frontend public config ───────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api.healthsync.go.ug
NEXT_PUBLIC_APP_NAME=HealthSync Uganda
