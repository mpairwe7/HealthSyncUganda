# HealthSync Uganda — Crane Cloud STAGING environment
#
# Copy to staging.env (gitignored) and fill in real values.
#
#   cp staging.env.example staging.env
#   $EDITOR staging.env
#
# Then deploy:
#   make -C infra/cranecloud deploy ENV=staging

# ── Crane Cloud project ──────────────────────────────────────────────────
# Fetch once with `cranecloud projects list`, paste UUID here.
CRANECLOUD_PROJECT_ID=

# ── Backend app ──────────────────────────────────────────────────────────
BACKEND_APP_NAME=healthsync-backend-staging
BACKEND_IMAGE=ghcr.io/mpairwe7/healthsync-uganda-backend
BACKEND_IMAGE_TAG=staging
BACKEND_PORT=8000
BACKEND_REPLICAS=1
# Populated after first `make deploy-backend` succeeds:
BACKEND_APP_ID=

# ── Frontend app ─────────────────────────────────────────────────────────
FRONTEND_APP_NAME=healthsync-frontend-staging
FRONTEND_IMAGE=ghcr.io/mpairwe7/healthsync-uganda-frontend
FRONTEND_IMAGE_TAG=staging
FRONTEND_PORT=3000
FRONTEND_REPLICAS=1
FRONTEND_APP_ID=

# ── Application config ───────────────────────────────────────────────────
APP_ENV=staging
APP_NAME=healthsync-uganda
LOG_LEVEL=DEBUG

# 32 random bytes (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
SECRET_KEY=

# ── Database (Crane Cloud Postgres add-on or external) ──────────────────
# Format: postgresql+asyncpg://USER:PASS@HOST:5432/DB
DATABASE_URL=

# ── Cache & queue ────────────────────────────────────────────────────────
REDIS_URL=

# ── Observability ────────────────────────────────────────────────────────
# Set if you have a NITA-U / Grafana OTel collector available; leave blank to disable.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=healthsync-api
OTEL_TRACES_SAMPLER=parentbased_always_on

# ── External integrations (mocks in staging) ─────────────────────────────
NIRA_BASE_URL=https://healthsync-backend-staging.cranecloud.ug/api/v1/interop/mock/nira
NIRA_API_KEY=mock-nira-key
DHIS2_BASE_URL=https://healthsync-backend-staging.cranecloud.ug/api/v1/interop/mock/dhis2
DHIS2_USERNAME=mock
DHIS2_PASSWORD=mock

# ── Resilience tuning ────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=200

# ── CORS — must include the frontend's deployed URL ──────────────────────
CORS_ALLOW_ORIGINS=https://healthsync-frontend-staging.cranecloud.ug

# ── Frontend public config ───────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://healthsync-backend-staging.cranecloud.ug
NEXT_PUBLIC_APP_NAME=HealthSync Uganda (staging)
