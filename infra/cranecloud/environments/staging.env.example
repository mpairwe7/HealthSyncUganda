# HealthSync Uganda — Crane Cloud STAGING environment
#
# Copy to staging.env (gitignored) and fill in real values.
#
#   cp staging.env.example staging.env
#   $EDITOR staging.env
#
# Then deploy:
#   make -C infra/cranecloud deploy ENV=staging

# ── Crane Cloud project ──────────────────────────────────────────────────
# Fetch once with `cranecloud projects list`, paste UUID here.
CRANECLOUD_PROJECT_ID=

# ── Postgres app (deployed as a Crane Cloud app, NOT the DaaS) ──────────
POSTGRES_APP_NAME=healthsync-postgres-staging
POSTGRES_IMAGE=docker.io/mpairwe7/healthsync-uganda-postgres
POSTGRES_IMAGE_TAG=main
POSTGRES_PORT=5432
POSTGRES_REPLICAS=1
POSTGRES_USER=healthsync
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=healthsync
# Populated after first `make deploy-postgres` succeeds:
POSTGRES_APP_ID=
# In-project DNS name (Crane Cloud UI confirms after deploy):
POSTGRES_HOSTNAME=healthsync-postgres-staging

# ── Redis app (deployed as a Crane Cloud app — no managed Redis DaaS) ───
REDIS_APP_NAME=healthsync-redis-staging
REDIS_IMAGE=redis
REDIS_IMAGE_TAG=7-alpine
REDIS_PORT=6379
REDIS_REPLICAS=1
# Random 32+ char password — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=
# Populated after first `make deploy-redis` succeeds:
REDIS_APP_ID=
# The hostname/URL Redis is reachable at from inside the Crane Cloud project.
# Crane Cloud surfaces this on the app's detail page after deploy. Paste it
# into REDIS_URL below so the backend connects through it.
REDIS_HOSTNAME=healthsync-redis-staging

# ── Backend app ──────────────────────────────────────────────────────────
BACKEND_APP_NAME=healthsync-backend-staging
BACKEND_IMAGE=docker.io/mpairwe7/healthsync-uganda-backend
BACKEND_IMAGE_TAG=staging
BACKEND_PORT=8000
BACKEND_REPLICAS=1
# Populated after first `make deploy-backend` succeeds:
BACKEND_APP_ID=

# ── Frontend app ─────────────────────────────────────────────────────────
FRONTEND_APP_NAME=healthsync-frontend-staging
FRONTEND_IMAGE=docker.io/mpairwe7/healthsync-uganda-frontend
FRONTEND_IMAGE_TAG=staging
FRONTEND_PORT=3000
FRONTEND_REPLICAS=1
FRONTEND_APP_ID=

# ── Application config ───────────────────────────────────────────────────
APP_ENV=staging
APP_NAME=healthsync-uganda
LOG_LEVEL=DEBUG

# 32 random bytes (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
SECRET_KEY=

# ── Database URL — points at the self-hosted Postgres app above ─────────
# Composed from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_HOSTNAME /
# POSTGRES_PORT / POSTGRES_DB. Example:
#   postgresql+asyncpg://healthsync:<password>@healthsync-postgres-staging:5432/healthsync
# Note: the `+asyncpg` suffix is required by the SQLAlchemy async engine.
DATABASE_URL=

# ── Cache & queue — Redis (the app deployed via make deploy-redis) ──────
# Composed from REDIS_HOSTNAME, REDIS_PORT, REDIS_PASSWORD above.
# Format: redis://:PASSWORD@HOSTNAME:6379/0
# Example (staging): redis://:${REDIS_PASSWORD}@healthsync-redis-staging:6379/0
# Note the LEADING COLON before PASSWORD — Redis URLs treat the
# user-part as empty and the password follows directly after the colon.
REDIS_URL=

# ── Observability ────────────────────────────────────────────────────────
# Set if you have a NITA-U / Grafana OTel collector available; leave blank to disable.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=healthsync-api
OTEL_TRACES_SAMPLER=parentbased_always_on

# ── External integrations (mocks in staging) ─────────────────────────────
NIRA_BASE_URL=https://healthsync-backend-staging.cranecloud.ug/api/v1/interop/mock/nira
NIRA_API_KEY=mock-nira-key
DHIS2_BASE_URL=https://healthsync-backend-staging.cranecloud.ug/api/v1/interop/mock/dhis2
DHIS2_USERNAME=mock
DHIS2_PASSWORD=mock

# ── Resilience tuning ────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=200

# ── CORS — must include the frontend's deployed URL ──────────────────────
CORS_ALLOW_ORIGINS=https://healthsync-frontend-staging.cranecloud.ug

# ── Frontend public config ───────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://healthsync-backend-staging.cranecloud.ug
NEXT_PUBLIC_APP_NAME="HealthSync Uganda (staging)"
