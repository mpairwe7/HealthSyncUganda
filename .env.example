# ─────────────────────────────────────────────────────────────────────────────
# HealthSync Uganda — sample environment
#
# This file is the *local-development* default. Copy to .env and tweak.
#
#   cp .env.example .env
#
# Two deployment shapes are supported out of the box:
#
#   1. Local dev (recommended for engineers):
#         scripts/dev-stack.sh       # brings up Postgres + Redis only
#         cd backend && uv run uvicorn app.main:app --reload --port 8000
#         cd frontend && bun run dev
#
#      → uses the URLs below (localhost-based, single host)
#
#   2. Full Docker Compose stack (recommended for the showcase demo):
#         docker compose up --build
#
#      → docker-compose.yml *overrides* the URLs to point at in-network
#        hostnames (postgres, redis, backend). You do NOT edit this file
#        for the Docker path.
#
# Anything secret (real NIRA key, real DHIS2 creds) must come from your
# secret manager — never check it in.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=healthsync-uganda
LOG_LEVEL=INFO
# 32+ random bytes. Generate fresh with: openssl rand -hex 32
SECRET_KEY=change-me-to-32-bytes-of-randomness-please

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local dev: docker-compose starts Postgres on localhost:5432
POSTGRES_USER=healthsync
POSTGRES_PASSWORD=healthsync
POSTGRES_DB=healthsync
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://healthsync:healthsync@localhost:5432/healthsync

# ─── Redis (REQUIRED for the full demo) ───────────────────────────────────────
# Used for: caching, rate-limit token buckets, idempotency replay, DHIS2
# outbox queue, NIRA fallback cache. The service still boots if Redis is
# unreachable — but several "wow" demo moments (idempotent replay, analytics
# cache, DHIS2 graceful degradation) need a real Redis to be visible.
REDIS_URL=redis://localhost:6379/0

# ─── Observability (OpenTelemetry) ────────────────────────────────────────────
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable telemetry locally.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=healthsync-api
OTEL_TRACES_SAMPLER=parentbased_always_on

# ─── External integrations ───────────────────────────────────────────────────
# Local dev: the FastAPI process serves its own mocks at /api/v1/interop/mock/*
# Production: override to https://api.nira.go.ug/... and https://dhis2.moh.go.ug/...
NIRA_BASE_URL=http://localhost:8000/api/v1/interop/mock/nira
NIRA_API_KEY=mock-nira-key
DHIS2_BASE_URL=http://localhost:8000/api/v1/interop/mock/dhis2
DHIS2_USERNAME=mock
DHIS2_PASSWORD=mock

# ─── Resilience defaults ─────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=200

# ─── Deployment / proxy ──────────────────────────────────────────────────────
# Source IPs whose X-Forwarded-* headers uvicorn will trust (consumed by the
# backend container entrypoint, not the app). "*" trusts any upstream —
# convenient for a single managed proxy, but it lets clients spoof their IP
# (rate-limit evasion, forged client IP in logs). In production set this to the
# platform's ingress IP/CIDR.
# FORWARDED_ALLOW_IPS=10.0.0.0/8

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=HealthSync Uganda
